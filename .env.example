# .env.example
# 豆包（ByteDance Ark）配置示例

# 豆包 API 配置
# 从 https://console.volcengine.com 获取 API Key
LLM_API_KEY=your-ark-api-key-here
DEEPSEEK_API_KEY=your-ark-api-key-here
DEEPSEEK_BASE_URL=https://ark.cn-beijing.volces.com

# Qdrant 配置
QDRANT_BASE_URL=http://localhost:6333
QDRANT_API_KEY=

# Redis 配置
REDIS_CONNECTION_STRING=localhost:6379
REDIS_ENABLED=true

# PostgreSQL 配置
DB_CONNECTION_STRING=Host=host.docker.internal;Port=5432;Database=knowledge_base;Username=postgres;Password=your-password-here

# ASP.NET Core 配置
ASPNETCORE_ENVIRONMENT=Development
ASPNETCORE_URLS=http://+:80

# 日志配置
LOG_LEVEL=Information
