{
  "//": "这是不同 LLM 提供商的配置示例，复制对应配置到 appsettings.json 的 LLM 节即可切换",

  "// ============ 豆包 (Doubao / 火山引擎) ============": "",
  "Doubao": {
    "Provider": "Doubao",
    "BaseUrl": "https://ark.cn-beijing.volces.com",
    "ApiKey": "你的豆包API密钥",
    "EmbeddingModel": "doubao-embedding-text-240715",
    "ChatModel": "doubao-1-5-pro-256k-250115",
    "EmbeddingEndpoint": "/api/v3/embeddings",
    "ChatEndpoint": "/api/v3/chat/completions",
    "VectorDimension": 2560
  },

  "// ============ OpenAI ============": "",
  "OpenAI": {
    "Provider": "OpenAI",
    "BaseUrl": "https://api.openai.com",
    "ApiKey": "sk-xxx你的OpenAI密钥",
    "EmbeddingModel": "text-embedding-3-small",
    "ChatModel": "gpt-4o",
    "EmbeddingEndpoint": "/v1/embeddings",
    "ChatEndpoint": "/v1/chat/completions",
    "VectorDimension": 1536
  },

  "// ============ Azure OpenAI ============": "",
  "AzureOpenAI": {
    "Provider": "AzureOpenAI",
    "BaseUrl": "https://你的资源名.openai.azure.com",
    "ApiKey": "你的Azure密钥",
    "EmbeddingModel": "text-embedding-ada-002",
    "ChatModel": "gpt-4",
    "EmbeddingEndpoint": "/openai/deployments/你的embedding部署名/embeddings?api-version=2024-02-01",
    "ChatEndpoint": "/openai/deployments/你的chat部署名/chat/completions?api-version=2024-02-01",
    "VectorDimension": 1536
  },

  "// ============ DeepSeek ============": "",
  "DeepSeek": {
    "Provider": "DeepSeek",
    "BaseUrl": "https://api.deepseek.com",
    "ApiKey": "你的DeepSeek密钥",
    "EmbeddingModel": "deepseek-embedding",
    "ChatModel": "deepseek-chat",
    "EmbeddingEndpoint": "/v1/embeddings",
    "ChatEndpoint": "/v1/chat/completions",
    "VectorDimension": 1536
  },

  "// ============ 阿里云通义千问 (Qwen) ============": "",
  "Qwen": {
    "Provider": "Qwen",
    "BaseUrl": "https://dashscope.aliyuncs.com/compatible-mode",
    "ApiKey": "你的阿里云密钥",
    "EmbeddingModel": "text-embedding-v3",
    "ChatModel": "qwen-max",
    "EmbeddingEndpoint": "/v1/embeddings",
    "ChatEndpoint": "/v1/chat/completions",
    "VectorDimension": 1024
  },

  "// ============ Ollama (本地部署) ============": "",
  "Ollama": {
    "Provider": "Ollama",
    "BaseUrl": "http://localhost:11434",
    "ApiKey": "ollama",
    "EmbeddingModel": "nomic-embed-text",
    "ChatModel": "llama3.1:8b",
    "EmbeddingEndpoint": "/v1/embeddings",
    "ChatEndpoint": "/v1/chat/completions",
    "VectorDimension": 768
  },

  "// ============ 智谱AI (GLM) ============": "",
  "Zhipu": {
    "Provider": "Zhipu",
    "BaseUrl": "https://open.bigmodel.cn/api/paas",
    "ApiKey": "你的智谱密钥",
    "EmbeddingModel": "embedding-3",
    "ChatModel": "glm-4-plus",
    "EmbeddingEndpoint": "/v4/embeddings",
    "ChatEndpoint": "/v4/chat/completions",
    "VectorDimension": 2048
  },

  "// ============ 月之暗面 Kimi (Moonshot) ============": "",
  "Moonshot": {
    "Provider": "Moonshot",
    "BaseUrl": "https://api.moonshot.cn",
    "ApiKey": "你的Moonshot密钥",
    "EmbeddingModel": "moonshot-v1-embedding",
    "ChatModel": "moonshot-v1-128k",
    "EmbeddingEndpoint": "/v1/embeddings",
    "ChatEndpoint": "/v1/chat/completions",
    "VectorDimension": 1024
  }
}
