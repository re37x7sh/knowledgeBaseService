{
  "Logging": {
    "LogLevel": {
      "Default": "Information",
      "Microsoft": "Warning"
    }
  },
  "AllowedHosts": "*",
  "ConnectionStrings": {
    "DefaultConnection": "Host=localhost;Port=5432;Database=knowledge_base;Username=postgres;Password=postgres"
  },
  "DeepSeek": {
    "ApiKey": "${DEEPSEEK_API_KEY}",
    "BaseUrl": "https://ark.cn-beijing.volces.com"
  },
  "Qdrant": {
    "BaseUrl": "http://localhost:6333",
    "Endpoint": "http://localhost:6333"
  },
  "Redis": {
    "ConnectionString": "${REDIS_CONNECTION_STRING}",
    "Enabled": true
  },
  "RAG": {
    "UseSemanticKernel": true,
    "UseSemanticChunking": true,
    "SemanticChunking": {
      "SimilarityThreshold": 0.65,
      "MaxChunkSize": 1500,
      "MinChunkSize": 100,
      "MinSentencesPerChunk": 3,
      "MaxSentencesPerChunk": 15,
      "WindowSize": 3,
      "OverlapRatio": 0.15,
      "OverlapSentences": 2,
      "EnableCaching": true,
      "CacheTTLDays": 1,
      "MaxBatchSize": 50,
      "MaxRetries": 3,
      "EnableParagraphAware": true,
      "EnableParallelProcessing": true
    },
    "UseHybridSearch": true,
    "HybridSearch": {
      "VectorWeight": 0.7,
      "Bm25Weight": 0.3
    }
  },
  "LLM": {
    "Provider": "Doubao",
    "BaseUrl": "https://ark.cn-beijing.volces.com",
    "ApiKey": "${LLM_API_KEY}",
    "EmbeddingModel": "doubao-embedding-text-240715",
    "ChatModel": "doubao-1-5-pro-256k-250115",
    "EmbeddingEndpoint": "/api/v3/embeddings",
    "ChatEndpoint": "/api/v3/chat/completions",
    "VectorDimension": 2560
  }
}