<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <TargetFramework>net8.0</TargetFramework>
    <Nullable>enable</Nullable>
    <ImplicitUsings>enable</ImplicitUsings>
    <LangVersion>latest</LangVersion>
    <!-- 禁用 Semantic Kernel 实验性 API 警告 -->
    <NoWarn>$(NoWarn);SKEXP0001;SKEXP0010;SKEXP0020;SKEXP0050;SKEXP0070</NoWarn>
  </PropertyGroup>

  <ItemGroup>
    <ProjectReference Include="..\KnowledgeBaseService.Core\KnowledgeBaseService.Core.csproj" />
    <ProjectReference Include="..\KnowledgeBaseService.Application\KnowledgeBaseService.Application.csproj" />
  </ItemGroup>

  <ItemGroup>
    <PackageReference Include="Microsoft.Extensions.Configuration.Abstractions" Version="8.0.0" />
    <PackageReference Include="Microsoft.Extensions.Http" Version="8.0.0" />
    <PackageReference Include="Npgsql" Version="9.0.4" />
    <PackageReference Include="SqlSugarCore" Version="5.1.4.210" />
    <!-- Semantic Kernel 核心包 -->
    <PackageReference Include="Microsoft.SemanticKernel" Version="1.28.0" />
    <!-- Semantic Kernel Qdrant 连接器 -->
    <PackageReference Include="Microsoft.SemanticKernel.Connectors.Qdrant" Version="1.28.0-preview" />
    <!-- Semantic Kernel Memory 插件 -->
    <PackageReference Include="Microsoft.SemanticKernel.Plugins.Memory" Version="1.28.0-alpha" />
    <!-- Redis 缓存 -->
    <PackageReference Include="StackExchange.Redis" Version="2.8.16" />
  </ItemGroup>

</Project>
